# ---------------------------------------------------------------------------------------------------------------------
# Rill / decisionflow. Everything listed here is either regenerated by the scripts in this repo or fetched from upstream.
# The small files that back every number in the paper (reports, summaries, aggregate.json, latency, the job queue) are
# kept.
# ---------------------------------------------------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Node
node_modules/

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Secrets
.env
.env.*

# Upstream clones (Kev, SemIf) with their own git history and virtualenvs; clone them into third_party/ (see README)
/third_party/

# Checkpoints and training runs (tens of GB)
/runs/
*.pt
*.ckpt
*.safetensors

# Training data and the RL pool: rebuilt by scripts/build_expB.py, build_expC.py and build_rlpool.py
/data/

# ONNX exports: rebuilt by scripts/export_demo.py and decisionflow/export.py
/export/
*.onnx

# Browser demo: demo/site is committed whole, including the packaged model, tokenizer and ONNX Runtime files (47 MB, made
# by scripts/export_demo.py and scripts/export_js_engine.py), so GitHub Pages can serve it as it is. The build directory
# keeps only the quantisation checks; the raw ONNX Runtime files used by the Node checks are not kept.
demo/site_build/*
!demo/site_build/quant_check.*.json
demo/ort.wasm.bundle.min.mjs
demo/*.wasm

# Per-question predictions (about 270 MB): rebuilt by scripts/eval_rill.py and baselines/run.py. Reports and summaries
# are kept; the generative outputs are small and feed a table, so they are kept too.
results/**/*.rows.json
results/**/*.predictions.jsonl
results/smoke/

# Logs: keep the job queue that produced the reported results, drop the rest
logs/*
!logs/gpu_queue.txt
!logs/gpu_queue2.txt
!logs/gpu_done.txt
!logs/gpu_done2.txt

# LaTeX intermediates (the PDFs are kept)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Build outputs
supplement.zip
